CCEffect %{
  techniques:
  - passes:
    - vert: sprite-vs:vert
      frag: sprite-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        alphaThreshold: { value: 0.5 }
        brightness: { value: 0.0 ,inspector : { displayName : "亮度[-1-1]" }}
        saturation: { value: 1.0 ,inspector : { displayName : "饱和度[0-2]" }}
        contrast: {value: 1.0 , inspector : { displayName : "对比度[0-2]" }}
        hue : { value: 0.0, inspector : { displayName : "色相[-180-180]" } }
}%

CCProgram sprite-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  #if SAMPLE_FROM_RT
    #include <common/common-define>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;

  out vec4 color;
  out vec2 uv0;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1);

    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif

    #if USE_PIXEL_ALIGNMENT
      pos = cc_matView * pos;
      pos.xyz = floor(pos.xyz);
      pos = cc_matProj * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif

    uv0 = a_texCoord;
    #if SAMPLE_FROM_RT
      CC_HANDLE_RT_SAMPLE_FLIP(uv0);
    #endif
    color = a_color;

    return pos;
  }
}%

CCProgram sprite-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>

  in vec4 color;

  uniform Constant{
    float brightness;
    float saturation;
    float contrast;
    float hue;
  }; 

  #if USE_TEXTURE
    in vec2 uv0;
    #pragma builtin(local)
    layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  #endif
    //rgb转hsv
    vec3 rgb2hsv(vec3 rgb) {
        float R = rgb.x, G = rgb.y, B = rgb.z;
        vec3 hsv;
        float max1 = max(R,max(G,B));
        float min1 = min(R,min(G,B));
        if (R == max1) {
            hsv.x = (G-B)/(max1-min1);
        }
        if (G == max1) {
            hsv.x = 2.0 + (B-R)/(max1-min1);
        }
        if (B == max1) {
            hsv.x = 4.0 + (R-G)/(max1-min1);
        }
        hsv.x = hsv.x * 60.0;   
        if (hsv.x < 0.0) {
            hsv.x = hsv.x + 360.0;
        }
        hsv.z = max1;
        hsv.y = (max1 - min1) / max1;
        return hsv;
  }
    //hsv转rgb
  vec3 hsv2rgb(vec3 hsv) {
        float R,G,B;
        //饱和度为0，说明没有颜色，颜色只能是亮度
        if(hsv.y == 0.0) {
            R = G = B = hsv.z;
        }
        else {
            //取得原始颜色基值
            hsv.x = hsv.x/60.0; 
            //取整，获得下标
            int i = int(hsv.x);
            //偏移
            float f = hsv.x - float(i);
            float a = hsv.z * ( 1.0 - hsv.y );
            float b = hsv.z * ( 1.0 - hsv.y * f );
            float c = hsv.z * ( 1.0 - hsv.y * (1.0 - f ) );
            //把圆圈分为6格
            if(i == 0) {
                R = hsv.z; G = c; B = a;
            }
            else if(i == 1) {
                R = b; G = hsv.z; B = a; 
            }
            else if(i == 2) {
                R = a; G = hsv.z; B = c; 
            }
            else if(i == 3) {
                R = a; G = b; B = hsv.z;
            }
            else if(i == 4) {
                R = c; G = a; B = hsv.z;
            }
            else {
                R = hsv.z; G = a; B = b; 
            }
        }
        return vec3(R,G,B);
  }

    vec4 frag () {
        vec4 o = vec4(1, 1, 1, 1);
        
        #if USE_TEXTURE
            o *= CCSampleWithAlphaSeparated(cc_spriteTexture, uv0);
            o.rgb += brightness;
            if(hue != 0.0) {
                //使用色相
                vec3 hsv = rgb2hsv(o.xyz); //转换为HSV
                hsv.x += hue; //调整偏移Hue值
                hsv.x = mod(hsv.x, 360.0); //超过360的值从0开始
                //hsv.y *= Saturation; //调整饱和度
                //hsv.z *= Value;
                o.xyz = hsv2rgb(hsv.xyz); //将调整后的HSV，转换为RGB颜色
            }
            //饱和度
            if(saturation != 1.0) {
                float gray = 0.2126 * o.r + 0.7152 * o.g + 0.0722 * o.b;
                vec3 grayColor = vec3(gray ,gray ,gray); 
                o.rgb = mix(grayColor , o.rgb , saturation);
            }
            //对比度
            if(contrast != 1.0) {
                vec3 avgColor = vec3(0.5 , 0.5 , 0.5);
                o.rgb = mix(avgColor , o.rgb , contrast);
            }
        #endif
        o *= color;
        //亮度
        
        ALPHA_TEST(o);
        return o;
    }


}%
